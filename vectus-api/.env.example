# Shared secret; the Dograh HTTP tool sends it as the X-API-Key header.
# Generate with: openssl rand -hex 32
VECTUS_API_KEY=
# DOGRAH_NETWORK=dograh_app-network
# Live area-manager table (LeadSquared Mavis rows/query URL incl. ?orgcode=...)
# and its x-api-key. Unset = KB file only.
MAVIS_URL=
MAVIS_API_KEY=
# MAVIS_REFRESH_HOURS=6
